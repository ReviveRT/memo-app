# The image installs its own vendor tree. Copying the host's would overwrite a
# --no-dev install with one that may include dev packages, and may have been
# resolved against a different PHP version.
vendor/

# Build artefacts and caches that must be regenerated inside the image. A stale
# packages.php copied in from the host would name providers from a different
# vendor tree; a config cache would freeze the host's environment into the image.
bootstrap/cache/*.php
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
.phpunit.cache/
.phpunit.result.cache

.env
.env.*
Dockerfile
.dockerignore
.DS_Store
*.log
