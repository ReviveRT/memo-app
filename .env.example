# Copy to .env only if you want to override something:
#
#     cp .env.example .env
#
# You do NOT need to do this to run the app. docker-compose.yml carries the same
# dev defaults inline, so `docker compose up` works on a clean checkout with no
# .env and no API keys. Every value below is a non-secret placeholder — the two
# API keys are intentionally blank and optional.
#
# Never commit .env. It is in .gitignore; keep it that way.

# --- Postgres ----------------------------------------------------------------
# Local dev credentials only. The containerized `db` service is created with
# these on first boot; there is no manual database setup step.
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo
POSTGRES_DB=memo

# Deliberately left commented out. docker-compose.yml builds the connection
# string from the three variables above, so changing POSTGRES_PASSWORD alone is
# enough and stays consistent everywhere. Setting DATABASE_URL here overrides
# that composition wholesale, and a stale copy of the old password in this line
# is a genuinely confusing way to break the stack.
#
# Uncomment it only to point at an external Postgres instead of the container —
# host is the compose service name `db`, not localhost. You then own provisioning
# the instance, role and database.
#DATABASE_URL=postgresql://memo:memo@db:5432/memo

# --- Laravel (the api service) ------------------------------------------------
# APP_ENV is informational here; nothing branches on it.
APP_ENV=local

# Off by default, including locally. With APP_DEBUG=true Laravel puts the stack
# trace and the resolved configuration into the response body, and /api/* is
# reachable through the web container's proxy. Turn it on while developing if you
# want traces in the browser; error detail is on stderr either way, via
# `docker compose logs api`.
APP_DEBUG=false

# Where Laravel's logs go. `stderr` is what Docker captures as the container's log
# stream. The alternative, `stack`, writes api/storage/logs/laravel.log — a file
# inside a container that nothing tails and that survives no rebuild.
LOG_CHANNEL=stderr

# APP_KEY is intentionally not listed. Laravel uses it for encryption, cookies and
# signed URLs; this API has no auth, no sessions and no cookies, so nothing reads
# it and every route works without one. If you add a feature that needs it, run
# `php artisan key:generate` inside the api container and put the value in .env —
# never in docker-compose.yml, and never committed.

# --- Host port mappings ------------------------------------------------------
# Only the host side of each mapping. Inside the compose network the services
# always talk on fixed ports (db:5432, api:8080), so changing these cannot break
# service-to-service traffic — it only moves where your browser and psql look.
# Change one if something else on your machine already owns the port; a conflict
# surfaces as "Bind for 0.0.0.0:5432 failed: port is already allocated".
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173

# --- Speech to text ----------------------------------------------------------
# Primary provider: local | fake | openai
#   local  - faster-whisper in the ai-worker container. No key, no account, no
#            network after the model has been fetched once. This is the default
#            and it needs nothing from you.
#   fake   - a fixed canned sentence, instantly. For the test suite, and for
#            watching the queue work without waiting on transcription.
#   openai - recognised but NOT built. Kept in this list because the seam it
#            would plug into is real and tested; left unwritten rather than
#            shipped as an adapter nobody has run against the live API.
#
# Setting `openai` is therefore not a dead end and not a lie either: the worker
# logs that it was skipped and STT_FALLBACK below transcribes the memo, which the
# row records as the provider that actually ran.
STT_PROVIDER=local

# Used when the primary provider cannot run at all — not built, model missing,
# out of memory. A recording that simply produced no words is *not* retried on
# this one: the second provider is handed the same audio and would reach the same
# answer.
STT_FALLBACK=local

# Which model the local provider runs. This is the accuracy lever, and it is a
# bigger one than it looks — measured on real accented speech, "I would like to
# place an order" came back from `base` as "I would like to blaze a door there".
#
#   model            disk    got it right
#   tiny             75 MB   no
#   base            142 MB   no
#   small           464 MB   no
#   medium          1.5 GB   partly
#   large-v3-turbo  1.6 GB   yes   <- default
#
# turbo is not the slow choice despite being the biggest: it is a large encoder
# with a four-layer decoder, so it beats `small` and is three times faster than
# the `medium` it out-transcribes. A short memo takes a few seconds; anything over
# two minutes of audio switches to batched decoding and the ten-minute maximum
# takes about two minutes rather than ten. The README explains why batching is not
# used on short memos — it costs accuracy there and buys nothing.
#
# What it costs is memory: 1.65 GB resident per replica, peaking at 2.4 GB while a
# long memo batches. Drop to `base` if you are short of disk or memory and your
# speakers are easy to understand.
STT_MODEL=large-v3-turbo

# Language of your recordings, as an ISO code — `en`, `ru`, `de`. Leave empty to
# detect it per recording, which is the default and is what lets one stack take
# memos in several languages.
#
# Worth setting if you only ever speak one. It skips a detection pass, which is
# about 30% of the job on a short memo, and it removes a real failure: detection
# runs on one window and is unreliable on short or accented audio, and a wrong
# guess does not degrade a transcript so much as ruin it.
STT_LANGUAGE=

# --- API keys (both optional) ------------------------------------------------
# Leave blank for the zero-config path. Nothing is committed because this file is
# the example, not .env.
#
# OPENAI_API_KEY is read by nothing today — transcription is local and free, and
# the variable is here because docker-compose.yml passes it through for whoever
# writes the hosted adapter. Without ANTHROPIC_API_KEY: memos still transcribe,
# store and search; they just get a fallback title and `enrichment_error` is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Claude model for the enrichment pass (title, summary, tags, category).
# claude-sonnet-5 or claude-haiku-4-5 are cheaper if you'd rather trade quality
# for cost on this stage.
ENRICH_MODEL=claude-opus-5

# --- Upload limits -----------------------------------------------------------
# Byte cap for the API edge (12 MiB). Deliberately looser than the duration cap:
# a WebM stream from MediaRecorder carries no duration, so length is enforced in
# the worker after normalization, not here.
#
# Enforced at POST /api/memos: anything larger is a 413 naming this limit, and
# nothing is written.
#
# Raising it is not enough on its own. It has to stay below `upload_max_filesize`
# in api/conf.d/uploads.ini (16 MiB) and well below `post_max_size` (20 MiB) --
# above those, PHP discards the upload before the application sees it, and the
# effect is uploads that vanish rather than a wider cap. GET /api/health reports
# all three numbers side by side and flags the mismatch.
MAX_AUDIO_BYTES=12582912

# Hard duration cap in seconds (10 minutes), enforced in the worker via ffprobe.
#
# In the worker and not at the API edge, because it cannot be enforced there. A
# browser recording arrives with no duration in its container -- MediaRecorder
# streams to a sink it cannot seek back into, so it never returns to write one --
# and ffprobe answers `N/A` for it. The number only exists after ffmpeg has
# rewritten the file, which is a step the worker owns. So a memo over this cap is
# accepted by POST /api/memos, stored, and then moved to `failed` with a
# `last_error` naming both lengths.
#
# Zero or negative is refused at boot rather than clamped: it would not be a
# strict cap, it would be a configuration under which every voice memo fails.
MAX_AUDIO_SECONDS=600

# --- Worker ------------------------------------------------------------------
# How long each ai-worker replica waits after finding the queue empty. This is a
# sleep on the idle path only -- after a claim that found work the worker loops
# straight back without waiting -- so it bounds how long a new memo sits in
# `queued`, not how fast the queue drains. Lower it if you want the status change
# to feel instant while demoing; it costs one small query per replica per interval.
WORKER_POLL_SECONDS=1.0

# Where audio is written inside the containers. Backed by the shared `audio`
# Docker volume: the API writes, the worker reads and deletes.
#
# Changing this needs a rebuild, not just a restart. api/Dockerfile creates this
# exact path in the image so that an empty volume inherits a group-writable
# directory owned by the uid both containers run as (MEMO-12) — point the mount
# somewhere the image never prepared and the API cannot write to it at all. To
# move it: edit the line below and rebuild with a matching build arg,
#
#     docker compose build --build-arg AUDIO_DIR=/srv/audio api
#
# An `audio` volume that is still empty picks up the new ownership by itself on the
# next start; one that already holds recordings does not, and needs
# `docker compose down -v`. NOTES.md has the four cases.
AUDIO_DIR=/data/audio
