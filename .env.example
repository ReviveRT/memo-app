# Copy to .env only if you want to override something:
#
#     cp .env.example .env
#
# You do NOT need to do this to run the app. docker-compose.yml carries the same
# dev defaults inline, so `docker compose up` works on a clean checkout with no
# .env and no API keys. Every value below is a non-secret placeholder — the two
# API keys are intentionally blank and optional.
#
# Never commit .env. It is in .gitignore; keep it that way.

# --- Postgres ----------------------------------------------------------------
# Local dev credentials only. The containerized `db` service is created with
# these on first boot; there is no manual database setup step.
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo
POSTGRES_DB=memo

# Deliberately left commented out. docker-compose.yml builds the connection
# string from the three variables above, so changing POSTGRES_PASSWORD alone is
# enough and stays consistent everywhere. Setting DATABASE_URL here overrides
# that composition wholesale, and a stale copy of the old password in this line
# is a genuinely confusing way to break the stack.
#
# Uncomment it only to point at an external Postgres instead of the container —
# host is the compose service name `db`, not localhost. You then own provisioning
# the instance, role and database.
#DATABASE_URL=postgresql://memo:memo@db:5432/memo

# --- Laravel (the api service) ------------------------------------------------
# APP_ENV is informational here; nothing branches on it.
APP_ENV=local

# Off by default, including locally. With APP_DEBUG=true Laravel puts the stack
# trace and the resolved configuration into the response body, and /api/* is
# reachable through the web container's proxy. Turn it on while developing if you
# want traces in the browser; error detail is on stderr either way, via
# `docker compose logs api`.
APP_DEBUG=false

# Where Laravel's logs go. `stderr` is what Docker captures as the container's log
# stream. The alternative, `stack`, writes api/storage/logs/laravel.log — a file
# inside a container that nothing tails and that survives no rebuild.
LOG_CHANNEL=stderr

# APP_KEY is intentionally not listed. Laravel uses it for encryption, cookies and
# signed URLs; this API has no auth, no sessions and no cookies, so nothing reads
# it and every route works without one. If you add a feature that needs it, run
# `php artisan key:generate` inside the api container and put the value in .env —
# never in docker-compose.yml, and never committed.

# --- Host port mappings ------------------------------------------------------
# Only the host side of each mapping. Inside the compose network the services
# always talk on fixed ports (db:5432, api:8080), so changing these cannot break
# service-to-service traffic — it only moves where your browser and psql look.
# Change one if something else on your machine already owns the port; a conflict
# surfaces as "Bind for 0.0.0.0:5432 failed: port is already allocated".
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173

# --- Speech to text ----------------------------------------------------------
# Primary provider: local | fake | groq | openai
#   local  - faster-whisper in the ai-worker container. No key, no account and no
#            network at all: the weights are baked into the image at build time,
#            so a running stack never fetches one. This is the default and it
#            needs nothing from you.
#   fake   - a fixed canned sentence, instantly. For the test suite, and for
#            watching the queue work without waiting on transcription.
#   groq   - the SAME whisper model, run on Groq's hardware instead of your CPU.
#            Measured against the live API: ~10-30x faster on a short memo and
#            over 100x on a long one (a nine-minute memo is ~353s of local CPU
#            against about 3 seconds). Needs GROQ_API_KEY below.
#
#            Same model, so same words -- but not byte-identical: the two
#            runtimes have different decoding defaults, so numbers can come back
#            as "one two three" rather than "1, 2, 3".
#
#            *** YOUR RECORDINGS LEAVE THIS MACHINE IF YOU SET THIS. ***
#            The audio is uploaded to a third party. Groq's free tier, like most,
#            reserves broader rights over submitted data than its paid tiers do.
#            Do not set this for recordings you would not hand to a stranger.
#            `local` is the default precisely so that this is a choice you make
#            rather than one you inherit.
#   openai - recognised but NOT built. Kept in this list because the seam it
#            would plug into is real and tested; left unwritten rather than
#            shipped as an adapter nobody has run against the live API.
#
# Setting `openai` is therefore not a dead end and not a lie either: the worker
# logs that it was skipped and STT_FALLBACK below transcribes the memo, which the
# row records as the provider that actually ran. The same is true of `groq` on a
# day Groq is down, rate-limited, or the key is wrong.
STT_PROVIDER=local

# Used when the primary provider cannot run at all — not built, model missing,
# out of memory. A recording that simply produced no words is *not* retried on
# this one: the second provider is handed the same audio and would reach the same
# answer.
STT_FALLBACK=local

# Which model the local provider runs. This is the accuracy lever, and it is a
# bigger one than it looks — measured on real accented speech, "I would like to
# place an order" came back from `base` as "I would like to blaze a door there".
#
#   model            disk    got it right
#   tiny             75 MB   no
#   base            142 MB   no
#   small           464 MB   no
#   medium          1.5 GB   partly
#   large-v3-turbo  1.6 GB   yes   <- default
#
# turbo is not the slow choice despite being the biggest: it is a large encoder
# with a four-layer decoder, so it beats `small` and is three times faster than
# the `medium` it out-transcribes. A short memo takes a few seconds; anything over
# two minutes of audio switches to batched decoding and the ten-minute maximum
# takes about two minutes rather than ten. The README explains why batching is not
# used on short memos — it costs accuracy there and buys nothing.
#
# What it costs is memory: 1.65 GB resident per replica, peaking at 2.4 GB while a
# long memo batches. Drop to `base` if you are short of disk or memory and your
# speakers are easy to understand.
#
# Only the default above is baked into the image. Setting this to anything else
# puts you back on a download: the worker resolves the name against HuggingFace on
# first use and caches it in the `model-cache` volume, so that run needs the
# internet and the first memo may fail while it finishes. To bake a different one
# instead, change DEFAULT_STT_MODEL in ai/memo_ai/config.py *and* rebuild with
# matching build arguments -- the README has the command and why it takes both.
STT_MODEL=large-v3-turbo

# Language of your recordings, as an ISO code — `en`, `ru`, `de`. Leave empty to
# detect it per recording, which is the default and is what lets one stack take
# memos in several languages.
#
# Worth setting if you only ever speak one, though it is a small win rather than
# a large one: the detection pass runs on a `tiny` model that answers in about
# 0.2s, so naming the language saves that and — more usefully — removes any
# chance of a wrong guess. Detection is unreliable on short or accented audio
# whatever model does it, and a wrong language ruins a transcript rather than
# degrading it.
STT_LANGUAGE=

# Your Groq API key. Only read when STT_PROVIDER=groq (or STT_FALLBACK=groq) —
# leaving it blank costs a stack running on `local` nothing, and is the shipped
# state.
#
# Get one free at https://console.groq.com — no card. The free tier allows 2,000
# recordings and eight hours of audio a day, which is more than this app will
# generate; there is no charge to exceed and nothing to cancel.
#
# Forgetting it is not a boot failure. The worker starts, and the first *voice*
# memo fails with a sentence naming this variable — then STT_FALLBACK transcribes
# it locally, so nothing is actually lost.
GROQ_API_KEY=

# Which model Groq runs. Separate from STT_MODEL above because the two name the
# same weights differently: faster-whisper says `large-v3-turbo`, Groq says
# `whisper-large-v3-turbo`.
#
# Turbo is the right default for the same reason it is locally, and here it is
# also three times cheaper than the alternative should you ever leave the free
# tier — $0.04 against $0.111 per hour of audio. `whisper-large-v3` is the other
# accepted value.
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Enrichment: title, summary, tags, category ------------------------------
# Which enricher runs after a memo is transcribed. Two names:
#
#   local   Qwen2.5-1.5B-Instruct, in the worker process, from the 1.1 GB GGUF
#           baked into the ai image. No key, no account, no network, no extra
#           container. This is the default and it is what produces the titles and
#           summaries you see on the cards.
#   none    Skip the pass. Memos still transcribe, store and search — they get a
#           short title cut out of the transcript by a heuristic, and no summary,
#           tags or category.
#
# Turn it off if memory is tight, which is the only reason to. The model is
# loaded on the first memo that needs enriching rather than at boot, so a worker
# that only handles text memos never pays for it. Once loaded it adds about
# 1.7 GB to a worker's RSS — but only ~0.6 GB of that is paid *per replica*,
# because the 1.1 GB of weights is mmap-ed read-only and both replicas share one
# copy in page cache. Measured, not estimated: the second replica to load reports
# those pages as Shared_Clean with Private_Clean at zero.
#
# What you give up on `none` is measurable: the heuristic answers "Meeting with
# my friend John" where the model answers a real summary and a category.
ENRICH_PROVIDER=local

# --- Ask my memos -------------------------------------------------------------
# The `ai-api` service: type a question above the memo list and a local model
# answers from the few memos that match, citing them. The same Qwen2.5-1.5B the
# enrichment pass uses, from the same baked weights — no key, no network.
#
# **These two are the latency.** Prompt processing dominates CPU inference, so
# what gets retrieved is what gets waited for, near enough linearly. Measured on
# an M-series Mac, warm model: one short memo answers in under two seconds, three
# short memos in about six, and three memos at the cap below — 3,600 characters,
# the worst case these settings allow — takes 24 seconds to the first word and 30
# to the last. The answer streams, so those are words appearing rather than a
# blank screen, and the memos it is reading are on screen within milliseconds.
#
# Raise them on a fast machine; five memos is free. The service refuses a pair
# that would need more context than it will load, at boot, naming both numbers.
ASK_TOP_K=3

# How much of one memo the model is shown. Less of a cut than it sounds: the
# excerpt is the passage around the words the question asked about, chosen by
# Postgres' own ts_headline, rather than the first 1,200 characters.
ASK_MEMO_CHARS=1200

# How long one answer may take before ai-api gives up on it, in seconds.
#
# Loose against a measured worst case of about 30 seconds, deliberately: it is
# here to stop a wedged generation holding the one model this service has, not to
# enforce a latency target. A laptop under load can be several times slower than
# the numbers above without being broken.
ASK_DEADLINE_SECONDS=180

# Where POST /api/ask proxies to. A compose service name, so it resolves inside
# the compose network and nowhere else — ai-api maps no host port, which is what
# keeps PHP the only thing your browser talks to.
#
# Point it elsewhere to run ai-api outside compose, e.g. on the host while you are
# editing the Python: http://host.docker.internal:8000
AI_API_URL=http://ai-api:8000

# Seconds to reach ai-api. Short on purpose: what this bounds is "that service is
# not running", and the useful answer to that is a 503 now rather than in a minute.
AI_API_CONNECT_TIMEOUT=5

# Seconds to wait for the next piece of an answer — not for all of it.
#
# Above ASK_DEADLINE_SECONDS on purpose. ai-api gives up on its own generation
# first and reports it as a readable error inside the stream; if this number were
# the smaller one, the API would cut the connection instead and the answer would
# just stop with nothing to explain it.
AI_API_READ_TIMEOUT=210

# --- API keys (both optional, and both read by nothing) ----------------------
# Leave blank. There is no paid service anywhere in this stack: transcription is
# local (STT_PROVIDER above) and so is enrichment (ENRICH_PROVIDER above), and
# both work with networking switched off once the image is built.
#
# The two variables stay because docker-compose.yml passes them through, and it
# passes them through for whoever writes a hosted adapter — memo_ai/stt/
# unimplemented.py is the seam on the transcription side. Setting one today
# changes nothing.
#
# This file is the example, not .env, so nothing here is committed either way.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Upload limits -----------------------------------------------------------
# Byte cap for the API edge (12 MiB). Deliberately looser than the duration cap:
# a WebM stream from MediaRecorder carries no duration, so length is enforced in
# the worker after normalization, not here.
#
# Enforced at POST /api/memos: anything larger is a 413 naming this limit, and
# nothing is written.
#
# Raising it is not enough on its own. It has to stay below `upload_max_filesize`
# in api/conf.d/uploads.ini (16 MiB) and well below `post_max_size` (20 MiB) --
# above those, PHP discards the upload before the application sees it, and the
# effect is uploads that vanish rather than a wider cap. GET /api/health reports
# all three numbers side by side and flags the mismatch.
MAX_AUDIO_BYTES=12582912

# Hard duration cap in seconds (10 minutes), enforced in the worker via ffprobe.
#
# In the worker and not at the API edge, because it cannot be enforced there. A
# browser recording arrives with no duration in its container -- MediaRecorder
# streams to a sink it cannot seek back into, so it never returns to write one --
# and ffprobe answers `N/A` for it. The number only exists after ffmpeg has
# rewritten the file, which is a step the worker owns. So a memo over this cap is
# accepted by POST /api/memos, stored, and then moved to `failed` with a
# `last_error` naming both lengths.
#
# Zero or negative is refused at boot rather than clamped: it would not be a
# strict cap, it would be a configuration under which every voice memo fails.
MAX_AUDIO_SECONDS=600

# --- Worker ------------------------------------------------------------------
# How long each ai-worker replica waits after finding the queue empty. This is a
# sleep on the idle path only -- after a claim that found work the worker loops
# straight back without waiting -- so it bounds how long a new memo sits in
# `queued`, not how fast the queue drains. Lower it if you want the status change
# to feel instant while demoing; it costs one small query per replica per interval.
WORKER_POLL_SECONDS=1.0

# How many times a memo is attempted before it is given up on, counting the first.
#
# The count is incremented by the statement that *claims* the memo, not by the one
# that records a failure. That is deliberate and it is what makes the cap hold for
# the memo that needs it most: a recording that crashes its worker never reaches a
# failure handler at all, so a counter incremented on the way out of a job would
# never move for it, and it would be retried forever.
#
# Not every failure is retried, so most memos never reach this number. A recording
# that ffmpeg cannot decode, or one over MAX_AUDIO_SECONDS, is terminal on its first
# attempt -- the same file will not decode on the third try either, and two more
# attempts would cost 90 seconds to say the same thing. What is retried is a
# provider that cannot run *right now*: a model still downloading, a load that ran
# out of memory.
MAX_ATTEMPTS=3

# The base of the exponential backoff between attempts, in seconds. Doubles each
# time and is jittered +/-20%, so the second attempt is ~30s out and the third ~60s.
#
# The jitter is not decoration: with two worker replicas, a failure they both hit at
# the same moment -- the model downloading, the database coming back -- would
# otherwise have them retry in lockstep forever.
RETRY_BACKOFF_SECONDS=30

# How long a memo may sit in `processing` before the worker assumes whoever claimed
# it is gone and takes it back. One hour.
#
# **It must exceed the longest a healthy job can take**, or it requeues work that is
# still running. That ceiling is the sum of every deadline a job can spend: 180s of
# ffprobe and ffmpeg, 300s waiting for a model to load, and a decode deadline of
# four times the audio -- 2,880s in total at MAX_AUDIO_SECONDS=600. So raising the
# duration cap raises this ceiling, and this number has to follow.
#
# You do not have to do that arithmetic yourself. The worker recomputes it at boot
# and logs a warning naming both numbers if the lease no longer clears it.
REAP_AFTER_SECONDS=3600

# How often each replica looks for expired leases. Well under the lease itself, so
# the delay it adds to a reaped memo is noise beside the hour it already waited.
REAPER_INTERVAL_SECONDS=60

# Where audio is written inside the containers. Backed by the shared `audio`
# Docker volume: the API writes, the worker reads and deletes.
#
# Changing this needs a rebuild, not just a restart. api/Dockerfile creates this
# exact path in the image so that an empty volume inherits a group-writable
# directory owned by the uid both containers run as (MEMO-12) — point the mount
# somewhere the image never prepared and the API cannot write to it at all. To
# move it: edit the line below and rebuild with a matching build arg,
#
#     docker compose build --build-arg AUDIO_DIR=/srv/audio api
#
# An `audio` volume that is still empty picks up the new ownership by itself on the
# next start; one that already holds recordings does not, and needs
# `docker compose down -v`. NOTES.md has the four cases.
AUDIO_DIR=/data/audio

# --- Owners --------------------------------------------------------------------
#
# Whose memos are whose. There is no account, no password and no JWT: each browser
# holds one long-lived HttpOnly cookie and every query is scoped by it.
# db/migrations/007_owners.sql has the design and, more usefully, its limits.
#
# Neither of these needs setting for local compose. They are here because the two
# cases a deployment might legitimately have are worth naming.

# The cookie name. One real reason to change it: two deployments of this app under
# different paths of the same hostname, which would otherwise overwrite each other's
# cookie, since cookies are scoped by domain rather than by origin or port.
#
# Renaming it silently logs every existing browser out — they present the old name,
# nothing reads it, and their memos become unreachable without a claim link.
OWNER_COOKIE=memo_owner

# How long a browser is remembered without visiting, in days.
#
# 400 is a ceiling rather than a round number: Chrome clamps cookie lifetimes to 400
# days and silently ignores anything longer. The window slides — the API re-sends the
# cookie on use — so this means "since you last opened the app".
#
# Keep `memo:prune-owners --days` at or above this. Deleting owners sooner than their
# cookies expire means a browser presenting a valid token that resolves to nothing,
# which to the person holding it is indistinguishable from their memos being deleted.
OWNER_COOKIE_DAYS=400

# --- Audio in a bucket (hosted deployments) -------------------------------------
#
# **Leave AUDIO_BUCKET empty and none of this applies.** Recordings then live on the
# shared `audio` volume at AUDIO_DIR above, which is what local compose wants.
#
# Set it and both runtimes switch: the API writes and signs playback URLs through
# App\Storage\S3AudioStorage, and the worker fetches through memo_ai/blobs.py. The
# bucket name alone is the switch — there is no AUDIO_DRIVER, because a driver name
# and a bucket name are two ways to spell one fact and a first way to contradict it.
#
# This exists because a free platform's filesystem is ephemeral: the container is
# rebuilt on every deploy and usually stopped when idle, and the disk goes with it.
# Without a bucket a memo's transcript survives in Postgres while its recording
# quietly disappears. deploy/README.md has the R2 setup.
#
# Half-configuring this is refused rather than tolerated: naming a bucket without an
# endpoint or credentials fails the worker at startup and the API on first upload,
# instead of failing memos one at a time with a misleading message.
AUDIO_BUCKET=
AUDIO_BUCKET_ENDPOINT=
AUDIO_BUCKET_KEY=
AUDIO_BUCKET_SECRET=

# Cloudflare R2 requires the literal `auto` and ignores it. Real S3 needs its own.
AUDIO_BUCKET_REGION=auto

# Path-style addressing (`endpoint/bucket/key`) rather than the bucket as a subdomain.
# R2 and MinIO want this; real AWS S3 does not.
AUDIO_BUCKET_PATH_STYLE=false
